{
	chapter.52B2E081A6E8A69F.title: "Roots"
	chapter_group.6096FE1BB3D3B049.title: "Маг"
	quest.013940B9D712F2A9.quest_desc: ["Небольшой, но полезный нож для того, чтобы срубать кору с деревьев! (В последующих крафтах пригодятся...)"]
	quest.03FC45B78113B9B7.quest_desc: ["Ягодки падают с некоторым шансом с листьев деревьев. Некоторые из ягод можно будет использовать в различных ритуалах......"]
	quest.03FC45B78113B9B7.quest_subtitle: "Ягодки!"
	quest.03FC45B78113B9B7.title: "5х Ягодок"
	quest.1DD3A3D5066F3EBF.quest_desc: ["&4НУ Я ЖЕ ГОВОРИЛ! НЕ ЕСТЬ! >:O&r"]
	quest.1DD3A3D5066F3EBF.quest_subtitle: "..."
	quest.1FC79D2FF4178384.quest_desc: ["С помощью наполнителя вы сможете создавать из палок посохи, наполняемые волшебным порошком, рецепты которых вы можете посмотреть в рунном планшете!"]
	quest.1FC79D2FF4178384.quest_subtitle: "Создание посохов!"
	quest.1FC79D2FF4178384.title: "Наполнитель"
	quest.2615F6CC0F91E99D.quest_desc: ["Поздравляю! Теперь вам открыт доступ ко всем ритуалам этого мода! "]
	quest.2615F6CC0F91E99D.quest_subtitle: ":D"
	quest.2615F6CC0F91E99D.title: "Доступ к ритуалам"
	quest.272EAD7344002863.quest_desc: ["Ты убил случайно свою корову? Ничего страшного! Возьми её останки и размести на алтаре и вуаля!"]
	quest.272EAD7344002863.title: "Воскрешение коровы"
	quest.2F265F735AD84FEF.quest_desc: ["Совместив зёрна, камень и дикий корень (Если ты, конечно его не съел) ты сможешь получить данную книгу, которая будет твоей методичкой по деланию заклинаний!"]
	quest.2F265F735AD84FEF.quest_subtitle: "Рунный планшет"
	quest.2FEA780CE58AB35B.quest_desc: ["Вы смогли убить визера...с друзьями или без... теперь вам открывается самые мощные заклинания, но прежде...вам нужно их скрафтить с помощью видоизменяющего порошка."]
	quest.2FEA780CE58AB35B.title: "Убийство визера"
	quest.4A2CB9110840A1D3.quest_desc: [
		"&m&5От RaytroTheProot  UwU&r&r"
		""
		""
		"&aПриветствую тебя, друг! Я, Рэйтро, ответственнен за данную главу квеста и твои первые шаги начинаются с мода Roots! &r"
		""
		"&aДовольно-таки короткий, но не менее интересный! С него-то, всё и начнётся и пригодится в будущих модах. Надеюсь, мой квест будет для тебя полезен и тем самым ты сможешь быстро развиться, несмотря гайды на ютубе.&r"
		""
		""
		"&4(НЕ ЕШЬ КОРНИ!)&r"
	]
	quest.4A2CB9110840A1D3.quest_subtitle: "Послание"
	quest.4A2CB9110840A1D3.title: "Начало"
	quest.514758409ED6E8D6.quest_desc: [
		"Есть 3 вида доп. улучшений для порошков:"
		""
		"-&aЗелёная веточка&r (+1)"
		"-&cАдская луковица&r (+2)"
		"-&5Глаз Дракона&r (+3)"
		""
		"-&aЗелёная веточка&r падает с различных посевов с некоторым шансом"
		"-&cАдская луковица&r падает с взросшего адского нароста с некоторым шансом"
		"-&5Глаз Дракона&r падает с хоруса с некоторым шансом"
		""
		"Порошки улучшений:"
		""
		"-&4Редстоун&r. Увеличивает эффективность вашего посоха"
		"-&7Порох&r. Увеличивает размер(радиус) используемого заклинания"
		"-&eСветокаменная Пыль&r. Усиливает ваше заклинание"
